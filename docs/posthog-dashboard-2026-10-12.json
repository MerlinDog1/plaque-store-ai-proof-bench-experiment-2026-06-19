    {
      "id": 6512512,
      "short_id": "mdjUUUzk",
      "name": "InstaPlaque — timestamped activity · last 24h",
      "description": "Newest 500 events in the exact rolling 24 hours (UTC), with fixed page labels and no customer identifiers. InstaPlaque production only; QA excluded. Open the insight to inspect events.",
      "query": {
        "kind": "DataVisualizationNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT timestamp AS time_utc, event AS action, properties.page AS page, properties.step AS designer_step, properties.source AS source, properties.campaign AS campaign, properties.device_type AS device, properties.$geoip_country_name AS approximate_country FROM events WHERE properties.site_id = 'instaplaque' AND properties.environment = 'production' AND properties.is_test = false AND timestamp >= now() - INTERVAL 24 HOUR AND timestamp < now() ORDER BY timestamp DESC LIMIT 500"
        },
        "display": "ActionsTable"
      },
